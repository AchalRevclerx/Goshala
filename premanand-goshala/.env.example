# Copy this file to ".env" and fill in real values. NEVER commit the real .env.

# REQUIRED in production. Long random string used to sign login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Initial admin account, created only on first run with an empty database.
# Set these BEFORE the first start so the insecure default is never used.
ADMIN_EMAIL=admin@yourdomain.org
ADMIN_PASSWORD=

# Mark the environment as production (enforces JWT_SECRET, enables HSTS, etc.)
NODE_ENV=production

# Comma-separated list of origins allowed to call the API from a browser.
# Leave empty for same-origin only (the frontend is served by this app).
ALLOWED_ORIGINS=

# Where DB backups are written. Point this OUTSIDE the deploy directory on the
# host so a redeploy never wipes your backups.
BACKUP_DIR=

# How many recent backups to keep.
BACKUP_RETENTION=14

# Port (Hostinger usually provides this automatically).
# PORT=3000
