# Copy this file to ".env" and fill in real values. NEVER commit the real .env.

# REQUIRED in production. Long random string used to sign login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin login credentials (username + password), set from .env.
# When both are set, this single admin can log in at admin-login.html with the
# username and password below. DB users (email login) remain available as a fallback.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Initial admin account, created only on first run with an empty database.
# Set these BEFORE the first start so the insecure default is never used.
# If ADMIN_USERNAME is set above, it is also used as the seeded admin email.
ADMIN_EMAIL=admin@yourdomain.org

# Mark the environment as production (enforces JWT_SECRET, enables HSTS, etc.)
NODE_ENV=production

# Comma-separated list of origins allowed to call the API from a browser.
# Leave empty for same-origin only (the frontend is served by this app).
ALLOWED_ORIGINS=

# PostgreSQL connection string.
DATABASE_URL=

# Where DB backups are written. Point this OUTSIDE the deploy directory on the
# host so a redeploy never wipes your backups.
BACKUP_DIR=

# How many recent backups to keep.
BACKUP_RETENTION=14

# Razorpay online payments. Get these from the Razorpay Dashboard
# (Settings -> API Keys). The SECRET must NEVER be exposed to the browser or
# committed to git. Leave blank to disable online payments (UPI QR still works).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Port (Hostinger usually provides this automatically).
# PORT=3000
